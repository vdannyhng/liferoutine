generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoutineType {
  INTERVAL
  WEEKLY_GOAL
  FIXED_SCHEDULE
  ONE_OFF
  MANUAL
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

enum CompletionKind {
  DONE
  SKIPPED
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  timezone  String?
  locale    String   @default("de-DE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories       Category[]
  routines         Routine[]
  completions      RoutineCompletion[]
  shoppingItems    ShoppingItem[]
  shoppingSessions ShoppingSession[]
  settings         AppSettings?
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  icon      String
  sortOrder Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  routines Routine[]

  @@unique([userId, name])
  @@index([userId, sortOrder])
}

model Routine {
  id         String  @id @default(cuid())
  userId     String
  categoryId String?

  title       String
  description String?
  type        RoutineType
  priority    Priority    @default(NORMAL)
  icon        String?

  /// false = deleted while keeping its history (soft delete)
  isActive Boolean   @default(true)
  isPaused Boolean   @default(false)
  pausedAt DateTime?

  /// When set, scheduling ignores completions before this instant ("Ab heute neu starten").
  rhythmAnchorAt DateTime?
  /// Snoozed routines are not considered due before this instant.
  snoozedUntil   DateTime?

  estimatedMinutes Int?

  /// Validated at runtime with Zod (see src/domain/routines/schedule.ts).
  scheduleConfig Json
  /// Validated at runtime with Zod (see src/domain/routines/schedule.ts).
  reminderConfig Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  completions RoutineCompletion[]

  @@index([userId, isActive])
}

model RoutineCompletion {
  id        String         @id @default(cuid())
  routineId String
  userId    String
  kind      CompletionKind @default(DONE)

  completedAt     DateTime
  durationMinutes Int?
  note            String?

  createdAt DateTime @default(now())

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([routineId, completedAt])
  @@index([userId, completedAt])
}

model ShoppingItem {
  id     String @id @default(cuid())
  userId String

  name     String
  quantity Float?
  unit     String?
  category String?
  note     String?

  isChecked Boolean   @default(false)
  createdAt DateTime  @default(now())
  checkedAt DateTime?

  /// Set when the item was bought and archived by "Einkauf abschließen".
  archivedAt DateTime?
  sessionId  String?

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session ShoppingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, archivedAt])
}

model ShoppingSession {
  id     String @id @default(cuid())
  userId String

  startedAt   DateTime
  completedAt DateTime
  itemCount   Int

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ShoppingItem[]

  @@index([userId, completedAt])
}

model AppSettings {
  userId String @id

  theme                 Theme     @default(SYSTEM)
  /// null = use the browser's time zone
  timezone              String?
  notificationsEnabled  Boolean   @default(false)
  weekStartsOn          Int       @default(1)
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
