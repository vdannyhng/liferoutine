# PostgreSQL connection for development.
# Replace USER and PASSWORD with your local Postgres credentials.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/routine_dev?schema=public"

# Separate database used by integration and E2E tests (it gets wiped).
TEST_DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/routine_test?schema=public"

# Development login: every request runs as this user until real auth is added.
DEV_USER_EMAIL="dev@routine.local"
